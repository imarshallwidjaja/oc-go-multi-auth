{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oc-go-multi-auth",
  "version": "0.1.2",
  "description": "Multi-account API key rotation for OpenCode Go subscription",
  "type": "module",
  "bin": {
    "oc-go-multi-auth": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --outfile dist/index.js --format esm --target node && bun build ./src/cli.ts --outfile dist/cli.js --format esm --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "multi-account",
    "auth",
    "plugin"
  ],
  "license": "MIT",
  "author": "imarshallwidjaja",
  "repository": {
    "type": "git",
    "url": "https://github.com/imarshallwidjaja/oc-go-multi-auth"
  },
  "homepage": "https://github.com/imarshallwidjaja/oc-go-multi-auth",
  "bugs": {
    "url": "https://github.com/imarshallwidjaja/oc-go-multi-auth/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
