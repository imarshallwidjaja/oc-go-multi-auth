{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-go-session-manager",
  "version": "0.1.0",
  "description": "Auto-handoff plugin for OpenCode Go with LanguageTool and Caveman compression",
  "type": "module",
  "bin": {
    "opencode-go-session-manager": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --outfile dist/index.js --format esm --target node && bun build ./src/cli.ts --outfile dist/cli.js --format esm --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "session-manager",
    "handoff",
    "languagetool",
    "caveman",
    "plugin"
  ],
  "license": "MIT",
  "author": "imarshallwidjaja",
  "repository": {
    "type": "git",
    "url": "https://github.com/BaconDroid/opencode-go-session-manager"
  },
  "homepage": "https://github.com/BaconDroid/opencode-go-session-manager",
  "bugs": {
    "url": "https://github.com/BaconDroid/opencode-go-session-manager/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
