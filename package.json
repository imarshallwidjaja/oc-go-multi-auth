{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oc-go-multi-auth",
  "version": "0.1.3",
  "description": "Multi-account API key rotation for OpenCode Go subscription",
  "type": "module",
  "bin": {
    "oc-go-multi-auth": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --outfile dist/index.js --format esm --target node && bun build ./src/tui.ts --outfile dist/tui.js --format esm --target node && bun build ./src/rpc.ts --outfile dist/rpc.js --format esm --target node && bun build ./src/cli.ts --outfile dist/cli.js --format esm --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "keywords": [
    "opencode",
    "multi-account",
    "auth",
    "plugin"
  ],
  "license": "MIT",
  "author": "imarshallwidjaja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imarshallwidjaja/oc-go-multi-auth.git"
  },
  "homepage": "https://github.com/imarshallwidjaja/oc-go-multi-auth",
  "bugs": {
    "url": "https://github.com/imarshallwidjaja/oc-go-multi-auth/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "opencode": ">=1.18.29 <2 || >=2.0.28 <3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29 <2",
    "@opencode/plugin": ">=2.0.28 <3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@opencode/plugin": "2.0.28",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "directories": {
    "doc": "docs"
  }
}
